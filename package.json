{
  "name": "movieboxd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:production": "node tests/production-smoke.ts",
    "test:live": "node --env-file-if-exists=.env tests/live-smoke.ts",
    "test:direct-live": "node --env-file-if-exists=.env tests/direct-live.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@tailwindcss/vite": "^4.1.0",
    "cheerio": "^1.2.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
