# TMDB → Settings → API → API Read Access Token (not your account password)
TMDB_READ_ACCESS_TOKEN=
# Alternative: fill TMDB_API_KEY instead of TMDB_READ_ACCESS_TOKEN.
TMDB_API_KEY=
# Local development. Render supplies PORT; its blueprint sets HOST=0.0.0.0.
PORT=3001
HOST=127.0.0.1
TMDB_CACHE_PATH=.data/tmdb.sqlite
